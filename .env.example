# Local development only. Change before sharing or deploying.
RABBITMQ_USER=ashkan
RABBITMQ_PASSWORD=replace-with-a-long-random-password
EVENTS_ENABLED=true

# Generate a unique random secret (at least 32 characters) before starting the gateway.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# PostgreSQL (four isolated logical databases on one local server)
DB_USER=hotel
DB_PASSWORD=replace-with-a-long-random-database-password
DB_POOL_SIZE=8
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-this-grafana-password

# Domain repository read-through cache
HOTEL_CACHE_TTL_SECONDS=30
HOTEL_CACHE_MAX_ENTRIES=1000

# Redis distributed cache
REDIS_PASSWORD=change-this-redis-password
REDIS_CACHE_ENABLED=true
REDIS_TIMEOUT_MS=250

# Public guest self-service portal
PORTAL_PORT=8085

# Guest portal authentication (replace with unique random values before deployment)
GUEST_OTP_SECRET=replace-with-a-random-secret-at-least-32-characters
PORTAL_COOKIE_SECURE=false
# Optional HTTPS endpoint that accepts {to, template, code, expiresInMinutes}
OTP_DELIVERY_WEBHOOK_URL=
OTP_DELIVERY_WEBHOOK_TOKEN=

# Payment ledger is isolated from booking and guest databases
PAYMENT_JDBC_URL=jdbc:postgresql://localhost:5432/ashkan_payment

# Payment provider webhook verification (replace with a unique random secret)
PAYMENT_WEBHOOK_SECRET=replace-with-a-random-secret-at-least-32-characters

FINANCE_PORT=8096
