FROM maven:3.9.9-eclipse-temurin-17 AS build
WORKDIR /workspace
COPY pom.xml .
RUN mvn -q -B dependency:go-offline
COPY src ./src
RUN mvn -q -B -DskipTests package dependency:copy-dependencies -DoutputDirectory=target/dependency

FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /workspace/target/ashkan-hotel-java-1.0.0.jar /app/app.jar
COPY --from=build /workspace/target/dependency /app/lib
RUN useradd --system --create-home --uid 10001 hotel && mkdir -p /app/data && chown -R hotel:hotel /app
USER hotel
EXPOSE 8091
ENTRYPOINT ["java","-cp","/app/app.jar:/app/lib/*"]
